# Local development only. Production's .env is NOT hand-maintained: deploy.yml
# generates it on every deploy from the `production` GitHub Environment — see
# README.md's "Deployment / CI/CD" section.

# Local development: also load docker-compose.local.yml, which publishes the
# backend (:8000) and frontend (:5173) ports directly and nginx on :8080. The
# base docker-compose.yml publishes none of them (ticket #71). Never set this in
# production — deploy.yml passes its own `-f` files.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
COMPOSE_PATH_SEPARATOR=:

# Postgres
POSTGRES_USER=animal_behavior
POSTGRES_PASSWORD=change-me
POSTGRES_DB=animal_behavior

# Backend
DATABASE_URL=postgresql+psycopg://animal_behavior:change-me@db:5432/animal_behavior
CORS_ORIGINS=http://localhost:5173

# Signs the short-lived Cut streaming/download tokens — see
# docs/adr/0002-media-access-tokens-in-url.md. Any long random value.
MEDIA_TOKEN_SECRET_KEY=change-me-to-a-long-random-value

# The app has no login of its own (ticket #72, docs/adr/0004-trust-mega-tronics-
# remove-application-auth.md): Mechatronics authenticates everyone in front of
# it and forwards their identity in an HTTP header, which the backend reads
# only to attribute each analysis. Set this to that header's name once known
# (see ticket #72's diagnostic step); leave it empty for local development,
# where there is no Mechatronics and no identity is recorded.
IDENTITY_HEADER_NAME=

# Media browser (ticket #18): the S3-compatible bucket holding Tests/Cuts/
# Datasets — see CONTEXT.md's "Media browser" decisions and
# backend/app/services/s3_client.py. S3_ADDRESSING_STYLE is almost always
# "path" for a self-hosted S3-compatible endpoint (e.g. Ceph RGW); leave it
# unset unless your endpoint needs "virtual".
S3_BUCKET=change-me
S3_ENDPOINT=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_ADDRESSING_STYLE=path

# Probed media info for a Cut (ticket #22) — see
# backend/app/services/media_prober.py. FFPROBE_PATH almost never needs
# overriding; the backend Docker image installs ffmpeg (which provides
# ffprobe) on PATH.
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

# Analysis worker (ticket #47, part of #44) — see
# worker/worker/__main__.py and backend/app/core/config.py. Reuses the same
# DATABASE_URL/S3_* variables above; these two rarely need overriding.
ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=5
ANALYSIS_WORKER_WORK_DIR=/data/analysis-worker

# Frontend (baked in at build time — see frontend/Dockerfile). Local development
# calls the backend directly. Production is built with `/api` (same origin, routed
# by nginx/ — ticket #71) by deploy.yml itself; this variable is not read there.
VITE_API_BASE_URL=http://localhost:8000/api
