# Local development only. Production's .env is NOT hand-maintained: deploy.yml
# generates it on every deploy from the `production` GitHub Environment — see
# README.md's "Deployment / CI/CD" section.

# Postgres
POSTGRES_USER=animal_behavior
POSTGRES_PASSWORD=change-me
POSTGRES_DB=animal_behavior

# Backend
DATABASE_URL=postgresql+psycopg://animal_behavior:change-me@db:5432/animal_behavior
CORS_ORIGINS=http://localhost:5173

# Auth (ticket #3: Login & session) — see docs/adr/0001-jwt-access-refresh-tokens.md
JWT_SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# The first Admin account, seeded on startup (CONTEXT.md's "Bootstrap" decision)
FIRST_ADMIN_EMAIL=admin@vives.be
FIRST_ADMIN_PASSWORD=change-me

# Invites (ticket #4: Admin adds a User). SMTP_HOST left empty logs invite
# emails instead of sending them — fine for local dev, set it for real
# sending. FRONTEND_BASE_URL is used to build the emailed invite link.
#
# To send via Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USE_TLS=true. SMTP_USERNAME is the full @gmail.com address.
# SMTP_PASSWORD must be a 16-character App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords) — a regular account
# password will not authenticate, and 2-Step Verification must be enabled
# first to generate one. Copying it with the spaces Google displays it
# with (e.g. "abcd efgh ijkl mnop") is fine, they're stripped automatically.
# SMTP_FROM_EMAIL must match SMTP_USERNAME (or a verified alias) — Gmail
# rejects/rewrites a From address that doesn't.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@vives.be
SMTP_USE_TLS=true
INVITE_TOKEN_EXPIRE_HOURS=72
FRONTEND_BASE_URL=http://localhost:5173

# Forgot-password reset (ticket #5). Shares the SMTP config above.
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Brute-force throttling on auth endpoints (ticket #7). Fixed-window
# limits: N attempts per WINDOW_SECONDS. Login/refresh count only *failed*
# attempts (a success never consumes the budget) per client IP; login also
# tracks failures per-account (email), which forgot-password's per-email
# limit is not the same risk as — see backend/app/core/config.py for the
# full reasoning. Defaults are generous enough that a legitimate user
# mistyping a password once or twice never gets throttled.
LOGIN_RATE_LIMIT_MAX_FAILED_ATTEMPTS_PER_IP=10
LOGIN_RATE_LIMIT_MAX_FAILED_ATTEMPTS_PER_EMAIL=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REFRESH_RATE_LIMIT_MAX_FAILED_ATTEMPTS_PER_IP=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=300
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=10
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS_PER_EMAIL=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# Media browser (ticket #18): the S3-compatible bucket holding Tests/Cuts/
# Datasets — see CONTEXT.md's "Media browser" decisions and
# backend/app/services/s3_client.py. S3_ADDRESSING_STYLE is almost always
# "path" for a self-hosted S3-compatible endpoint (e.g. Ceph RGW); leave it
# unset unless your endpoint needs "virtual".
S3_BUCKET=change-me
S3_ENDPOINT=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_ADDRESSING_STYLE=path

# Probed media info for a Cut (ticket #22) — see
# backend/app/services/media_prober.py. FFPROBE_PATH almost never needs
# overriding; the backend Docker image installs ffmpeg (which provides
# ffprobe) on PATH.
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

# Analysis worker (ticket #47, part of #44) — see
# worker/worker/__main__.py and backend/app/core/config.py. Reuses the same
# DATABASE_URL/S3_* variables above; these two rarely need overriding.
ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=5
ANALYSIS_WORKER_WORK_DIR=/data/analysis-worker

# Frontend (baked in at build time — see frontend/Dockerfile)
VITE_API_BASE_URL=http://localhost:8000
