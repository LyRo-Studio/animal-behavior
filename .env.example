# Postgres
POSTGRES_USER=animal_behavior
POSTGRES_PASSWORD=change-me
POSTGRES_DB=animal_behavior

# Backend
DATABASE_URL=postgresql+psycopg://animal_behavior:change-me@db:5432/animal_behavior
CORS_ORIGINS=http://localhost:5173

# Auth (ticket #3: Login & session) — see docs/adr/0001-jwt-access-refresh-tokens.md
JWT_SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# The first Admin account, seeded on startup (CONTEXT.md's "Bootstrap" decision)
FIRST_ADMIN_EMAIL=admin@vives.be
FIRST_ADMIN_PASSWORD=change-me

# Frontend (baked in at build time — see frontend/Dockerfile)
VITE_API_BASE_URL=http://localhost:8000
