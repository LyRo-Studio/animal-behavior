# Applies to any build using the repo root as its context: worker/Dockerfile
# and cutting-worker/Dockerfile (need repo-root context to reuse backend/app
# source) and, since ticket #115, backend/Dockerfile too (needs the sibling
# consolidation/ folder). frontend/Dockerfile still uses its own scoped
# context and .dockerignore instead.
.git
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
backend/.venv
backend/tests
worker/.venv
worker/tests
frontend/node_modules
frontend/dist
companystyle

# Real, non-fixture research data that may sit locally alongside
# consolidation/'s source (ticket #114/#115) — same exclusion as .gitignore;
# backend/Dockerfile only ever COPYs the two named .py modules explicitly,
# but this is a second guard against ever baking real data into an image.
consolidation/*.xlsx
consolidation/*.ipynb
